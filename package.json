{
  "name": "mecenazgo-verificador",
  "version": "1.0.0",
  "private": true,
  "description": "Comprobacion y simulador fiscal de mecenazgo segun la Ley 49/2002, con Chakra UI",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:fuentes": "node scripts/check-fuentes.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@react-pdf/renderer": "^4.9.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
